# This file is an OVERVIEW of every environment variable used across the
# whole project. The one you actually copy and fill in is backend/.env.example
# (copy it to backend/.env) — this root-level file is just for reference.

# --- Web Push (Stage 4) ---
# Matches the public key in frontend/js/config.js. Generated during this
# build, so for real peace of mind, regenerate your own before the real
# 15 days start: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BCqxS9x0Bk15_jeUnVlOK19ieXFcSTRcko9GZmhK-XbW5pBkjP4C_inGWJDeAxMPY96rXdJ4j_0mkykFC_wSBJ0
VAPID_PRIVATE_KEY=F7hYoQqKmnQpnsgRjQoOzdhoB_-tsLrXcVRE_qWsejk
VAPID_SUBJECT=mailto:you@example.com

# --- Database (Stage 3, Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduler auth (Stage 5) ---
# Sent by the GitHub Actions cron job so nobody else can trigger a send.
SCHEDULER_SECRET=7ecdde9f81cf52f6144868e3603acdc3b896574f481ec50c

# --- Notification timing (Stage 5) ---
NOTIFICATION_TIME=09:00
NOTIFICATION_TIMEZONE=Asia/Kolkata

# --- Server (Stage 3) ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500
