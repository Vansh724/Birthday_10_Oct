# Copy this file to backend/.env and fill in the two Supabase values below.
# backend/.env is already gitignored — never commit it.

PORT=3000

# Leave unset or "development" locally. Set to "production" when you
# deploy — this disables /api/test-notification so it can never be hit
# from outside during the real 15 days.
NODE_ENV=development

# The frontend origin(s) allowed to call this API. Comma-separate if you
# ever have more than one (e.g. localhost during dev + your deployed URL).
CORS_ORIGIN=http://localhost:5500 , https://birthday-10-oct.vercel.app

# --- Supabase (Stage 3) ---
# From your Supabase project: Settings → API
#   SUPABASE_URL          = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" key (NOT the "anon" key —
#   the service role key bypasses row-level security, which is fine here
#   since only this backend uses it, but it must never reach the frontend)
SUPABASE_URL=https://uiwpsemuoqudyyjasyms.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVpd3BzZW11b3F1ZHl5amFzeW1zIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDQzMjc4MSwiZXhwIjoyMTA2MDA4NzgxfQ.2fkeYT6ledRYBQBcRnw8aZSYlscBKNvsra8_f4R_KjI

# --- Web Push (Stage 4) ---
VAPID_PUBLIC_KEY=BCqxS9x0Bk15_jeUnVlOK19ieXFcSTRcko9GZmhK-XbW5pBkjP4C_inGWJDeAxMPY96rXdJ4j_0mkykFC_wSBJ0
VAPID_PRIVATE_KEY=F7hYoQqKmnQpnsgRjQoOzdhoB_-tsLrXcVRE_qWsejk
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduler auth (Stage 5) ---
# Sent by the GitHub Actions cron job so nobody else can trigger a send.
SCHEDULER_SECRET=7ecdde9f81cf52f6144868e3603acdc3b896574f481ec50c

# --- Notification timing (Stage 5) ---
NOTIFICATION_TIME=09:00
